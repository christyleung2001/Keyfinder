                              isTop
                                ? 'bg-slate-950 border-indigo-500/80 shadow-lg shadow-indigo-500/10'
                                : 'bg-slate-950/50 border-slate-800/80 hover:border-slate-700'
                            }`}
                          >
                            {isTop && (
                              <div className="absolute top-0 right-0 bg-indigo-600 text-white text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-bl-lg shadow">
                                Best Match
                              </div>
                            )}

                            <div className="flex items-start justify-between mb-3">
                              <div>
                                <h4 className="font-bold text-lg text-white">{match.scaleName}</h4>
                                <p className="text-xs text-indigo-400 font-medium">{match.keySig}</p>
                              </div>
                              <div className="text-right">
                                <span className={`text-lg font-black ${
                                  match.confidence >= 90 ? 'text-emerald-400' : match.confidence >= 70 ? 'text-amber-400' : 'text-slate-400'
                                }`}>
                                  {match.confidence}%
                                </span>
                              </div>
                            </div>

                            {/* Scale Notes & Corresponding Solfège Notation */}
                            <div className="mb-4 bg-slate-900/80 p-3 rounded-lg border border-slate-800/80">
                              <div className="mb-2">
                                <span className="text-[11px] text-slate-400 block mb-1">Note Names:</span>
                                <div className="flex flex-wrap gap-1">
                                  {match.scalePitches.map((p) => {
                                    const name = pitchToName(p);
                                    const isUserInput = selectedNotes.includes(CHROMATIC_SCALE[p]);
                                    return (
                                      <span
                                        key={p}
                                        className={`px-2 py-0.5 rounded text-xs font-mono font-bold ${
                                          isUserInput
                                            ? 'bg-indigo-600/30 text-indigo-200 border border-indigo-500/50'
                                            : 'bg-slate-800 text-slate-400 border border-slate-700/50'
                                        }`}
                                      >
                                        {name}
                                      </span>
                                    );
                                  })}
                                </div>
                              </div>

                              {/* Solfege Row */}
                              <div>
                                <span className="text-[11px] text-amber-400/90 font-semibold block mb-1">Solfège (sol-fa):</span>
                                <div className="flex flex-wrap gap-1 font-mono">
                                  {solfegeList.map((syllable, i) => (
                                    <span
                                      key={i}
                                      className="px-2 py-0.5 rounded text-xs font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30"
                                    >
                                      {syllable}
                                    </span>
                                  ))}
                                </div>
                              </div>
                            </div>

                            {/* Relative & Parallel Information */}
                            <div className="text-xs space-y-1 text-slate-400 pt-3 border-t border-slate-800/80">
                              {match.relativeKey && (
                                <div className="flex justify-between">
                                  <span>Relative Key:</span>
                                  <span className="text-slate-200 font-medium">{match.relativeKey}</span>
                                </div>
                              )}
                              <div className="flex justify-between">
                                <span>Matched Notes:</span>
                                <span className="text-emerald-400 font-semibold">{match.matchedCount} of {match.totalInput}</span>
                              </div>
                              {match.extraNotes.length > 0 && (
                                <div className="flex justify-between text-red-400">
                                  <span>Out of Key Notes:</span>
                                  <span>{match.extraNotes.join(', ')}</span>
                                </div>
                              )}
                            </div>

                            {/* Play Scale Audio Button */}
                            <button
                              onClick={() => {
                                match.scalePitches.forEach((p, i) => {
                                  setTimeout(() => playTone(p, 0.4, 4), i * 250);
                                });
                              }}
                              className="w-full mt-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center justify-center gap-1.5 transition-colors"
                            >
                              <Play className="w-3.5 h-3.5 text-emerald-400" /> Play Full Scale Audio
                            </button>

                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>
            )}

            {/* TAB 2: DIATONIC CHORDS */}
            {activeTab === 'chords' && (
              <div>
                {!topMatch ? (
                  <p className="text-slate-400 text-sm">Select notes to generate diatonic chords.</p>
                ) : (
                  <div>
                    <div className="mb-6 flex items-center justify-between">
                      <div>
                        <h3 className="text-lg font-bold text-white">Diatonic Triads for {topMatch.scaleName}</h3>
                        <p className="text-xs text-slate-400">Harmonized chords built on each degree of the scale</p>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
                      {diatonicChords.map((chord) => (
                        <div
                          key={chord.numeral}
                          className="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between hover:border-indigo-500/50 transition-all text-center"
                        >
                          <div>
                            <span className="text-xs font-mono font-bold text-indigo-400 block mb-1">{chord.numeral}</span>
                            <span className="font-bold text-lg text-white block mb-2">{chord.chordName}</span>
                          </div>

                          <div className="my-2">
                            <span className="text-[10px] text-slate-500 block mb-1">{chord.degreeName}</span>
                            <div className="flex justify-center gap-1">
                              {chord.notes.map((n) => (
                                <span key={n} className="text-xs font-mono bg-slate-800 px-1.5 py-0.5 rounded text-slate-300">
                                  {n}
                                </span>
                              ))}
                            </div>
                          </div>

                          <button
                            onClick={() => playChord(chord.pitches)}
                            className="w-full mt-3 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600 text-indigo-300 hover:text-white border border-indigo-500/30 text-xs font-semibold flex items-center justify-center gap-1 transition-all"
                          >
                            <Play className="w-3 h-3" /> Play
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            {/* TAB 3: CIRCLE OF FIFTHS */}
            {activeTab === 'circle' && (
              <div className="flex flex-col items-center">
                <div className="text-center mb-6">
                  <h3 className="text-lg font-bold text-white">Interactive Circle of Fifths</h3>
                  <p className="text-xs text-slate-400 max-w-md">
                    Shows structural relationships between the 12 chromatic key signatures.
                  </p>
                </div>

                {/* SVG CIRCLE OF FIFTHS */}
                <div className="relative w-80 h-80 sm:w-96 sm:h-96">
                  <svg className="w-full h-full transform -rotate-90" viewBox="-120 -120 240 240">
                    <circle cx="0" cy="0" r="100" className="fill-slate-950 stroke-slate-800" strokeWidth="2" />
                    <circle cx="0" cy="0" r="65" className="fill-slate-900 stroke-slate-800" strokeWidth="1" />

                    {CIRCLE_OF_FIFTHS.map((item, idx) => {
                      const angleRad = (item.angle * Math.PI) / 180;
                      
                      // Outer circle pos (Major keys)
                      const x1 = Math.cos(angleRad) * 82;
                      const y1 = Math.sin(angleRad) * 82;

                      // Inner circle pos (Minor keys)
                      const x2 = Math.cos(angleRad) * 48;
                      const y2 = Math.sin(angleRad) * 48;

                      const isMatchedMajor = topMatch && topMatch.rootNote === item.note;

                      return (
                        <g key={item.note}>
                          {/* Major Key Circle Node */}
                          <circle
                            cx={x1}
                            cy={y1}
                            r="14"
                            className={`transition-all cursor-pointer ${
                              isMatchedMajor
                                ? 'fill-indigo-600 stroke-indigo-400 shadow-lg'
                                : 'fill-slate-800 hover:fill-slate-700 stroke-slate-700'
                            }`}
                            onClick={() => updateNotes([item.note])}
                          />
                          <text
                            x={x1}
                            y={y1}
                            textAnchor="middle"
                            dominantBaseline="central"
                            className={`text-[10px] font-extrabold font-mono pointer-events-none transform rotate-90 ${
                              isMatchedMajor ? 'fill-white' : 'fill-slate-200'
                            }`}
                          >
                            {item.note}
                          </text>

                          {/* Minor Key Label */}
                          <text
                            x={x2}
                            y={y2}
                            textAnchor="middle"
                            dominantBaseline="central"
                            className="text-[8px] font-mono fill-slate-400 transform rotate-90"
                          >
                            {item.minor}m
                          </text>
                        </g>
                      );
                    })}
                  </svg>
                </div>

                <div className="mt-6 text-xs text-slate-400 flex items-center gap-2">
                  <span className="w-3 h-3 rounded-full bg-indigo-600 inline-block"></span>
                  <span>Highlighted circle indicates the identified primary key</span>
                </div>
              </div>
            )}

            {/* TAB 4: THEORY REFERENCE */}
            {activeTab === 'theory' && (
              <div className="space-y-6">
                <div>
                  <h3 className="text-lg font-bold text-white mb-1">Music Theory Reference Guide</h3>
                  <p className="text-xs text-slate-400">Understanding standard scale formulas and intervals</p>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {SCALE_FORMULAS.map((f) => (
                    <div key={f.name} className="p-4 rounded-xl bg-slate-950 border border-slate-800">
                      <div className="flex items-center justify-between mb-2">
                        <h4 className="font-bold text-indigo-300 text-sm">{f.name}</h4>
                        <span className="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-slate-800 text-slate-400">
                          {f.type}
                        </span>
                      </div>
                      <p className="text-xs text-slate-400 mb-3">
                        Interval pattern (semitones): <span className="font-mono text-slate-200">{f.intervals.join(' - ')}</span>
                      </p>
                      <div className="text-[11px] text-slate-500">
                        Degrees: {f.degreeNames.join(', ')}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>

      </main>

      {/* FOOTER */}
      <footer className="border-t border-slate-800/80 mt-12 py-6 text-center text-xs text-slate-500">
        <div className="max-w-7xl mx-auto px-4">
          KeyFinder Studio • Built for Musicians, Educators, and Audio Enthusiasts
        </div>
      </footer>

    </div>
  );
}

