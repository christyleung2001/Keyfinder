// Helper to normalize note inputs into standard Pitch Classes (0 to 11)
function normalizeNote(noteStr) {
  if (!noteStr) return null;
  let clean = noteStr.trim().toUpperCase()
    .replace('♭', 'B')
    .replace('♯', '#')
    .replace('DB', 'C#')
    .replace('EB', 'D#')
    .replace('GB', 'F#')
    .replace('AB', 'G#')
    .replace('BB', 'A#');
  
  if (ENHARMONIC_MAP[clean]) {
    clean = ENHARMONIC_MAP[clean];
  }
  
  const index = CHROMATIC_SCALE.indexOf(clean);
  return index !== -1 ? { name: clean, pitch: index } : null;
}

// Map Pitch Index back to pretty string representation
function pitchToName(pitch, preferFlat = false) {
  const norm = (pitch + 12) % 12;
  const name = CHROMATIC_SCALE[norm];
  if (preferFlat) {
    const flatMap = { 'C#': 'D♭', 'D#': 'E♭', 'F#': 'G♭', 'G#': 'A♭', 'A#': 'B♭' };
    return flatMap[name] || name;
  }
  return name;
}

// Convert note index to frequency (A4 = 440 Hz)
function noteToFreq(pitchIndex, octave = 4) {
  // C4 is midi note 60, pitchIndex 0 = C
  const midi = (octave + 1) * 12 + pitchIndex;
  return 440 * Math.pow(2, (midi - 69) / 12);
}

